statement ok
set datafusion.execution.target_partitions = 1;

statement ok
set datafusion.execution.batch_size = 1024;

statement ok
CREATE EXTERNAL TABLE a STORED AS PARQUET LOCATION 'data/aggregation_duplicates.parquet';

statement ok
CREATE EXTERNAL TABLE b STORED AS PARQUET LOCATION 'data/aggregation_duplicates.parquet';

# Test case for a bug where aggregations incorrectly generated duplicate rows
# when spilling to disk. Runs with `FairSpillPool` configured (see `test_context.rs`).
query I
WITH
    joined AS (
        SELECT
            col_a, col_b, col_c, col_d, col_e, col_f, col_g, col_h,
            MAX(val_a) AS val_a,
            MAX(val_b) AS val_b
        FROM (
            SELECT col_a, col_b, col_c, col_d, col_e, col_f, col_g, col_h, val  AS val_a, NULL AS val_b FROM a UNION ALL
            SELECT col_a, col_b, col_c, col_d, col_e, col_f, col_g, col_h, NULL AS val_a, val  AS val_b FROM b
        )
        GROUP BY col_f, col_g, col_e, col_b, col_a, col_c, col_d, col_h
    ),
    duplicates AS (
        SELECT col_f, col_g, col_e, col_b, col_a, col_c, col_d, col_h
        FROM joined
        GROUP BY col_f, col_g, col_e, col_b, col_a, col_c, col_d, col_h
        HAVING COUNT(1) > 1
    )
SELECT COUNT(1)
FROM duplicates;
----
0
